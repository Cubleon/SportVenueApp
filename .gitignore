#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment files and local configuration (may contain credentials)
.env
.env.*
!.env.example
!.env.*.example
*.local
*.local.json
*.local.yaml
*.local.yml

# Signing keys, certificates, and provisioning profiles
*.jks
*.keystore
*.p12
*.p8
*.pem
*.key
*.mobileprovision
key.properties
android/key.properties
ios/ExportOptions.plist

# Third-party service configuration containing application credentials
google-services.json
GoogleService-Info.plist
firebase_options.dart

# Local editor and OS state
.vscode/
.fleet/
.zed/
Thumbs.db
Desktop.ini

# Golden test output: when a picture does not match, Flutter writes the
# master, the new render and their difference here to be looked at.
test/failures/
